     implicit none
     real(dl) :: gboost_delta = 0._dl, gboost_at = 1.e-4_dl
     real(dl) :: vc_alpha = 1._dl, vc_me = 1._dl   ! fine-structure constant and electron mass at recombination / today
+    real(dl) :: vc_zs = -1._dl, vc_dz = 30._dl   ! electron mass relaxes to 1 around z = vc_zs (disabled if < 0)
     contains
     function Gfac(a)
     real(dl), intent(in) :: a
@@ -37,4 +38,19 @@
     vc_alpha = al
     vc_me = me
     end subroutine set_vconst
+    function me_at_z(z)
+    real(dl), intent(in) :: z
+    real(dl) :: me_at_z
+    if (vc_zs < 0._dl) then
+        me_at_z = vc_me
+    else
+        me_at_z = 1._dl + (vc_me - 1._dl)*0.5_dl*(1._dl + tanh((z - vc_zs)/vc_dz))
+    end if
+    end function me_at_z
+    subroutine set_vswitch(zs, dz) bind(C, name='set_vswitch')
+    use iso_c_binding
+    real(c_double), value :: zs, dz
+    vc_zs = zs
+    vc_dz = dz
+    end subroutine set_vswitch
     end module GBoost
